{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.notuebernachtung.invalid/plankorrektur.schema.json",
  "title": "Plankorrektur",
  "description": "Monatsabschluss/JJJJ-MM/Plankorrekturen/<zeit>_<von>_<person>-<bereich>.json – nur vor der Unterschrift der Person, mit bestätigter Warnung.",
  "type": "object",
  "properties": {
    "monat": {
      "$ref": "gemeinsam.schema.json#/$defs/monat"
    },
    "person": {
      "type": "string"
    },
    "bereich": {
      "$ref": "gemeinsam.schema.json#/$defs/bereich"
    },
    "tage_hinzu": {
      "type": "array",
      "items": {
        "$ref": "gemeinsam.schema.json#/$defs/datum"
      }
    },
    "tage_weg": {
      "type": "array",
      "items": {
        "$ref": "gemeinsam.schema.json#/$defs/datum"
      }
    },
    "grund": {
      "type": "string",
      "minLength": 1
    },
    "von": {
      "$ref": "gemeinsam.schema.json#/$defs/person"
    },
    "um": {
      "$ref": "gemeinsam.schema.json#/$defs/zeitpunkt"
    },
    "warnung_bestaetigt": {
      "const": true
    },
    "_meta": {
      "$ref": "gemeinsam.schema.json#/$defs/meta_unveraenderlich"
    }
  },
  "required": [
    "monat",
    "person",
    "bereich",
    "tage_hinzu",
    "tage_weg",
    "grund",
    "von",
    "um",
    "warnung_bestaetigt",
    "_meta"
  ],
  "additionalProperties": false
}
