{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.notuebernachtung.invalid/version.schema.json",
  "title": "Schema-Version",
  "description": "_app/version.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 0
    },
    "mindest_app_version": {
      "type": "string"
    },
    "ordner_angelegt": {
      "$ref": "gemeinsam.schema.json#/$defs/zeitpunkt"
    },
    "hinweis": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "mindest_app_version",
    "ordner_angelegt",
    "hinweis"
  ],
  "additionalProperties": false
}
